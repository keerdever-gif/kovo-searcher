# Choose: auto, browser-use, or openai
KOVO_MODEL_PROVIDER=auto

# Recommended Browser Use model provider
BROWSER_USE_API_KEY=
KOVO_BROWSER_MODEL=bu-2-0

# Optional direct OpenAI model provider
OPENAI_API_KEY=
KOVO_OPENAI_MODEL=gpt-4o-mini

# Optional: set true to use Browser Use Cloud instead of a local browser
KOVO_BROWSER_CLOUD=false
